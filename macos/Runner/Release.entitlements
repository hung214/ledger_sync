<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- 雲端同步（FR-Y7）：連外至 Google Drive／OAuth 端點——沙箱必要。
	     缺此 entitlement 時 Release 版無法建立對外連線（同步/OAuth 失敗）。 -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- PC 掃描（PM 2026-10-29）：讀取使用者以檔案對話框選取的發票圖片； -->
	<!-- 匯出 CSV（PM 2026-11-19）：存檔對話框寫入使用者所選路徑——read-write 缺一不可 -->
	<!-- （沙箱必要；僅 read-only 時存檔被擋、檔案憑空消失）。 -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
